# Copy to dk.local.env (gitignored) and point at your own vault item.
#
# Any value starting with op:// is treated as a 1Password secret reference and
# resolved with `op read`. Plain values are used as-is, so this file works
# whether or not you use 1Password.
DK_CLIENT_ID=op://Private/DigiKey API/username
DK_CLIENT_SECRET=op://Private/DigiKey API/credential

# Optional
DK_LOCALE_SITE=US
DK_LOCALE_CURRENCY=USD
